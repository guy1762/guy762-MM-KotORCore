<Defs>
	
	
	<DrugPolicyDef>
		<defName>SWCPDrugPolicy_DroidRepairKits</defName>
		<label>carry droid repair kits</label>
		<entries>
			<li><drug>guy762_repairkit</drug><takeToInventory>3</takeToInventory></li>
			<li><drug>guy762_repairkit_adv</drug><takeToInventory>3</takeToInventory></li>
			<li><drug>guy762_repairkit_con</drug><takeToInventory>3</takeToInventory></li>
		</entries>
	</DrugPolicyDef>
	
	
	
	
	
	
	
	<HediffDef>
		<defName>guy762_repairkitHeal</defName>
		<description>A droid's auto-repair functions, boosted by a repair kit. Heals 15 points of wound damage.</description>
		<label>repair kit</label>
		<hediffClass>HediffWithComps</hediffClass>
		<maxSeverity>1.0</maxSeverity>
		<stages>
		  <li>
			<!-- <naturalHealingFactor>1000</naturalHealingFactor> -->
			<totalBleedFactor>0.75</totalBleedFactor>
		  </li>
		</stages>
		<comps>
			<!--2,500 ticks per hour in game-->
			<li Class="HediffCompProperties_Disappears">
				<!-- <disappearsAfterTicks>500</disappearsAfterTicks> -->
				<!-- <showRemainingTime>True</showRemainingTime> -->
				<disappearsAfterTicks>500</disappearsAfterTicks><showRemainingTime>False</showRemainingTime> <!-- failsafe to remove the hediff if there's still healing points left over -->
			</li>
			
			<li Class="FCP.Core.Stims.HediffCompProperties_Stimpack">
                <HealPermanentInjuries>True</HealPermanentInjuries>
                <HealMissingBodyParts>false</HealMissingBodyParts>
                <RemoveHediffWhenDone>True</RemoveHediffWhenDone>
                <ScaleHealedAmountWithTotalHitPoints>true</ScaleHealedAmountWithTotalHitPoints>
                <HealedAmount>15</HealedAmount>
                <TickMinimumBetweenHealing>2</TickMinimumBetweenHealing>
                <TickMaximumBetweenHealing>4</TickMaximumBetweenHealing>
            </li>
		</comps>
	</HediffDef>
  
	<ThingDef ParentName="guy762_DrugPillBase">
		<defName>guy762_repairkit</defName>
		<label>repair kit</label>
		<description>Included are the basic tools needed to repair a droid that has been damaged in combat.\n\nHeals 15 points of wound damage. Can only be used by droids.</description>
		<descriptionHyperlinks>
			<HediffDef>guy762_repairkitHeal</HediffDef>
		</descriptionHyperlinks>
		<possessionCount>7</possessionCount>
		<graphicData>
		  <texPath>Items/repairkits/repairkit</texPath>
		  <graphicClass>Graphic_StackCount</graphicClass>
		  <drawSize>0.85</drawSize>
		</graphicData>
		<socialPropernessMatters>false</socialPropernessMatters>
		<rotatable>false</rotatable>
		<statBases>
		  <MarketValue>25</MarketValue>
		  <WorkToMake>1000</WorkToMake>
		  <Mass>0.04</Mass>
		  <Flammability>0.5</Flammability>
		</statBases>
		<stackLimit>25</stackLimit>
		<techLevel>Spacer</techLevel>
		<ingestible>
		  <drugCategory>Medical</drugCategory>
		  <baseIngestTicks>10</baseIngestTicks>
		  <ingestSound>kotorsound_upgrade</ingestSound>
		  <preferability>NeverForNutrition</preferability>
		  <outcomeDoers>
			<li Class="IngestionOutcomeDoer_GiveHediff">
			  <hediffDef>guy762_repairkitHeal</hediffDef>
			  <severity>1.0</severity>
			</li>
			<!-- <li Class="ArtificialBeings.IngestionOutcomeDoer_SplitEffects"> -->
				<!-- <organicEffect>ABF_Hediff_Synstruct_Toxicated</organicEffect> -->
				<!-- <organicSeverity>1</organicSeverity> -->
				<!-- <artificialEffect>guy762_repairkitHeal</artificialEffect> -->
				<!-- <artificialSeverity>1</artificialSeverity> -->
			<!-- </li> -->
		  </outcomeDoers>
		</ingestible>
		<tradeTags>
		  <li>guy762TT_DroidEquipment</li>
		  <li>guy762TT_DroidConsumables</li>
		</tradeTags>
		<comps>
		  <li Class="InstantHealingDrug.CompProperties_DrugInstantHeal">
			<listOrder>1758</listOrder>
			<isCombatEnhancingDrug>true</isCombatEnhancingDrug>
		  </li>
		</comps>
		<orderedTakeGroup>Medicine</orderedTakeGroup>
		
		<recipeMaker>
		  <!--researchPrerequisite></researchPrerequisite-->
		  <recipeUsers>
			<li MayRequire="Killathon.ArtificialBeings.SynCore">ABF_Thing_Synstruct_PartWorkbench</li>
		  </recipeUsers>
		</recipeMaker>
		<costList>
		  <ComponentIndustrial>2</ComponentIndustrial>
		</costList>
	</ThingDef>
  
  
  
  
  
  
