<?xml version="1.0" encoding="utf-8" ?>
<Defs>


	
	
	<!-- scopes -->
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartScope_accuracy</defName>
		<label>accuracy scope</label>
		<labelShort>accuracy scope</labelShort>
		<description>A simple scope that offers enhanced magnification.</description>
		<attachedTo>guy762_KotORMount_scope</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.2</Mass>
			<AccuracyTouch>0.10</AccuracyTouch>
			<AccuracyShort>0.10</AccuracyShort>
			<AccuracyMedium>0.10</AccuracyMedium>
			<AccuracyLong>0.10</AccuracyLong>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_scopeitem_accuracy>1</guy762_scopeitem_accuracy>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartScope_crippling</defName>
		<label>crippling scope</label>
		<labelShort>crippling scope</labelShort>
		<description>A scope with a built-in targeting computer that detects weak points on selected targets.</description>
		<attachedTo>guy762_KotORMount_scope</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.3</Mass>
			<RangedWeapon_DamageMultiplier>0.1</RangedWeapon_DamageMultiplier>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_scopeitem_crippling>1</guy762_scopeitem_crippling>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartScope_holographic</defName>
		<label>holographic scope</label>
		<labelShort>holographic scope</labelShort>
		<description>A lightweight, compact scope for close-range combat. It does not provide much magnification, however, and is less effective against distant targets.</description>
		<attachedTo>guy762_KotORMount_scope</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.1</Mass>
			<AccuracyTouch>0.25</AccuracyTouch>
			<AccuracyShort>0.25</AccuracyShort>
		  </statOffsets>
		  <verbPropsOffset>
			<warmupTime>-0.2</warmupTime>
		  </verbPropsOffset>
		  
		</effects>
		<costList>
		  <guy762_scopeitem_holographic>1</guy762_scopeitem_holographic>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartScope_targeting</defName>
		<label>targeting scope</label>
		<labelShort>targeting scope</labelShort>
		<description>A scope with an advanced built-in targeting computer. Increases accuracy at longer ranges, but is very cumbersome, and not as effective against closer targets.</description>
		<attachedTo>guy762_KotORMount_scope</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.3</Mass>
			<AccuracyMedium>0.25</AccuracyMedium>
			<AccuracyLong>0.25</AccuracyLong>
		  </statOffsets>
		  <verbPropsOffset>
			<warmupTime>-0.2</warmupTime>
		  </verbPropsOffset>
		
		</effects>
		<costList>
		  <guy762_scopeitem_targeting>1</guy762_scopeitem_targeting>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	
	
	
	
	
	<!-- power cells -->
	
	<ModularWeapons2.ModularPartsDef Name="guy762_KotORpartPCell_optimized" ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartPCell_optimized</defName>
		<label>optimized power cell</label>
		<labelShort>optimized cell</labelShort>
		<description>A ranged upgrade which decreases cooldown between bursts.</description>
		<attachedTo>guy762_KotORMount_power_NoVerbs</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.3</Mass>
			<RangedWeapon_Cooldown>-0.25</RangedWeapon_Cooldown>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_pcellitem_optimized>1</guy762_pcellitem_optimized>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	
	<ModularWeapons2.ModularPartsDef Name="guy762_KotORpartPCell_pulsator" ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartPCell_pulsator</defName>
		<label>power pulsator</label>
		<labelShort>power pulsator</labelShort>
		<description>A ranged upgrade which adds additional energy to the blaster's bolt.</description>
		<attachedTo>guy762_KotORMount_power_NoVerbs</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.3</Mass>
			<RangedWeapon_DamageMultiplier>0.2</RangedWeapon_DamageMultiplier>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_pcellitem_pulsator>1</guy762_pcellitem_pulsator>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	<ModularWeapons2.ModularPartsDef Name="guy762_KotORpartPCell_rylith" ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartPCell_rylith</defName>
		<label>Rylith power cell</label>
		<labelShort>Rylith cell</labelShort>
		<description>A ranged upgrade which collects and stores solar energy. Greatly increases power output, with the downside of increasing recharge time as well.</description>
		<attachedTo>guy762_KotORMount_power_NoVerbs</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.3</Mass>
			<RangedWeapon_DamageMultiplier>0.4</RangedWeapon_DamageMultiplier>
			<RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_pcellitem_rylith>1</guy762_pcellitem_rylith>
		</costList>
		<researchPrerequisites>
		  <li>guy762_ResearchKotOR_advupgrade</li>
		</researchPrerequisites>
	</ModularWeapons2.ModularPartsDef>
	
	
	
	
	
	
	
	<!-- chambers -->
	
	
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartChamber_precision</defName>
		<label>precision chamber</label>
		<labelShort>precision chamber</labelShort>
		<description>A ranged upgrade which increases the blaster's accuracy.</description>
		<attachedTo>guy762_KotORMount_chamber</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.3</Mass>
			<AccuracyTouch>0.20</AccuracyTouch>
			<AccuracyShort>0.20</AccuracyShort>
			<AccuracyMedium>0.20</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_chamberitem_precision>1</guy762_chamberitem_precision>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartChamber_amp</defName>
		<label>amplifying chamber</label>
		<labelShort>amplifying chamber</labelShort>
		<description>A ranged upgrade which increases a blaster's energy output.</description>
		<attachedTo>guy762_KotORMount_chamber</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.3</Mass>
			<RangedWeapon_DamageMultiplier>0.2</RangedWeapon_DamageMultiplier>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_chamberitem_amp>1</guy762_chamberitem_amp>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartChamber_carbonite</defName>
		<label>carbonite chamber</label>
		<labelShort>carbonite chamber</labelShort>
		<description>A ranged upgrade which utilizes a liquid Carbonite cooling mechanism of Tetan design to decrease a blaster's cooldown between bursts.</description>
		<attachedTo>guy762_KotORMount_chamber</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.5</Mass>
			<RangedWeapon_Cooldown>-0.5</RangedWeapon_Cooldown>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_chamberitem_carbonite>1</guy762_chamberitem_carbonite>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartChamber_mando</defName>
		<label>Mandalorian chamber</label>
		<labelShort>Mandalorian chamber</labelShort>
		<description>An advanced firing chamber of Mandalorian design, this upgrade boosts damage output as well as accuracy.</description>
		<attachedTo>guy762_KotORMount_chamber</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.5</Mass>
			<AccuracyTouch>0.10</AccuracyTouch>
			<AccuracyShort>0.10</AccuracyShort>
			<AccuracyMedium>0.10</AccuracyMedium>
			<AccuracyLong>0.10</AccuracyLong>
			<RangedWeapon_DamageMultiplier>0.1</RangedWeapon_DamageMultiplier>
		  </statOffsets>
		  <equippedStatOffsets>
			<MeleeDodgeChance>-0.25</MeleeDodgeChance>
			<VEF_RangedDodgeChance MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">-0.25</VEF_RangedDodgeChance>
		  </equippedStatOffsets>
		  
		</effects>
		<costList>
		  <guy762_chamberitem_mando>1</guy762_chamberitem_mando>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	
	
	
	<!-- beam splitters -->
	
	<ModularWeapons2.ModularPartsDef Name="guy762_KotORpartBeam_splitter" ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartBeam_splitter</defName>
		<label>beam splitter</label>
		<labelShort>beam splitter</labelShort>
		<description>A ranged upgrade which splits a blaster's beam, increasing shots fired per burst.</description>
		<attachedTo>guy762_KotORMount_beam_NoVerbs</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.2</Mass>
		  </statOffsets>
		  <verbPropsOffset>
			<burstShotCount>3</burstShotCount>
		  </verbPropsOffset>
		  
		</effects>
		<costList>
		  <guy762_beamitem_splitter>1</guy762_beamitem_splitter>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	<ModularWeapons2.ModularPartsDef Name="guy762_KotORpartBeam_focuser" ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartBeam_focuser</defName>
		<label>beam focuser</label>
		<labelShort>beam focuser</labelShort>
		<description>A ranged upgrade which focuses a blaster's beam, increasing range and accuracy.</description>
		<attachedTo>guy762_KotORMount_beam_NoVerbs</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.2</Mass>
			<AccuracyTouch>0.2</AccuracyTouch>
			<AccuracyShort>0.2</AccuracyShort>
			<AccuracyMedium>0.2</AccuracyMedium>
			<AccuracyLong>0.2</AccuracyLong>
		  </statOffsets>
		  <verbPropsOffset>
			<range>5</range>
		  </verbPropsOffset>
		  
		</effects>
		<costList>
		  <guy762_beamitem_focuser>1</guy762_beamitem_focuser>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	
	
	<!-- triggers -->
	
	<ModularWeapons2.ModularPartsDef Name="guy762_KotORpartTrigger_hair" ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartTrigger_hair</defName>
		<label>hair trigger</label>
		<labelShort>hair trigger</labelShort>
		<description>A highly sensitive trigger mechanism that allows the user to fire more bolts per burst.</description>
		<attachedTo>guy762_KotORMount_trigger_NoVerbs</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.1</Mass>
		  </statOffsets>
		  <verbPropsOffset>
			<burstShotCount>3</burstShotCount>
			<ticksBetweenBurstShots>-3</ticksBetweenBurstShots>
		  </verbPropsOffset>
		  
		</effects>
		<costList>
		  <guy762_triggeritem_hair>1</guy762_triggeritem_hair>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
</Defs>