<Defs>


	
	
	<!-- edges -->
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartEdge_devaronian</defName>
		<label>Devaronian edge</label>
		<labelShort>Devaronian edge</labelShort>
		<description>Devaronian Blood-poison is a gemstone that can release poison into a victim's bloodstream. Application of Devaronian particles on a blade's edge can cause great pain to the weapon's victim.</description>
		<attachedTo>guy762_KotORMount_edge</attachedTo>
		<effects>
		
		  <statOffsets>
			<Mass>0.1</Mass>
			
			<MeleeWeapon_DamageMultiplier>0.2</MeleeWeapon_DamageMultiplier>
			<MeleeWeapon_AverageArmorPenetration>0.4</MeleeWeapon_AverageArmorPenetration>
		  </statOffsets>
		  
		</effects>
		<costList>
		  <guy762_edgeitem_devaronian>1</guy762_edgeitem_devaronian>
		</costList>
	</ModularWeapons2.ModularPartsDef>
	
	
	<ModularWeapons2.ModularPartsDef ParentName="guy762_KotORModularPartBase">
		<defName>guy762_KotORpartEdge_neutronium</defName>
		<label>Neutronium edge</label>
		<labelShort>Neutronium edge</labelShort>
		<description>Neutronium is a highly durable and resilient material used in the creation of durasteel. It can be used to increase the damage inflicted by a blade.</description>
