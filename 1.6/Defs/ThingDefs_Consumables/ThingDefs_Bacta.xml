<?xml version="1.0" encoding="UTF-8"?>
<Defs>

	
	<HediffDef>
		<defName>SWCPHediff_BactaHeal</defName>
		<label>Bacta Healing</label>
		<description>Longer-lasting regenerative agents from applied Bacta gel. Grants immunity to most poisons while active, in addition to boosting immunity gain speed, natural healing factor, and providing minor damage resistance. Will heal permanent injuries.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<maxSeverity>1.0</maxSeverity>

		<stages>
			<li>
				<naturalHealingFactor>1000</naturalHealingFactor>
				<totalBleedFactor>0.25</totalBleedFactor>
				
				<makeImmuneTo>    <!-- poison hediffs also need a HediffCompProperties_RemoveIfOtherHediff to be removed by this hediff !!! -->
					<li>guy762_Poison_saber</li>
					<li>ToxicBuildup</li>
					<li MayRequire="guy762.Lee.KotORPotF">SWPotF_hediff_ForceAffliction</li>
					<li MayRequire="guy762.Lee.KotORPotF">SWPotF_hediff_ForcePlague</li>
				</makeImmuneTo>
				<statOffsets>
					<ImmunityGainSpeedFactor>100</ImmunityGainSpeedFactor>
					<IncomingDamageFactor>-0.05</IncomingDamageFactor>
				</statOffsets>
			</li>
		</stages>
		<comps>
			<!--2,500 ticks per hour in game-->
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>2500</disappearsAfterTicks>
				<showRemainingTime>True</showRemainingTime>
			</li>
			<li Class="FCP.Core.Stims.HediffCompProperties_Stimpack">
                <HealPermanentInjuries>true</HealPermanentInjuries>
				
                <HealMissingBodyParts>false</HealMissingBodyParts>
                <RemoveHediffWhenDone>False</RemoveHediffWhenDone>
                <ScaleHealedAmountWithTotalHitPoints>true</ScaleHealedAmountWithTotalHitPoints>
                <HealedAmount>50</HealedAmount>
                <TickMinimumBetweenHealing>99</TickMinimumBetweenHealing>
                <TickMaximumBetweenHealing>101</TickMaximumBetweenHealing>
            </li>
		</comps>
	</HediffDef>
  
	<ThingDef ParentName="guy762_DrugPillBase">
		<defName>SWCPItem_Bacta</defName>
		<label>Bacta</label>
		<description>.</description>
		<descriptionHyperlinks>
			<HediffDef>SWCPHediff_BactaHeal</HediffDef>
		</descriptionHyperlinks>
		<possessionCount>1</possessionCount>
		<graphicData>
			<texPath>Items/Consumables/Bacta</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
			<drawSize>1.5</drawSize>
		</graphicData>
		<socialPropernessMatters>false</socialPropernessMatters>
		<rotatable>false</rotatable>
		<statBases>
			<MarketValue>100</MarketValue>
			<Mass>1</Mass>
			<Flammability>0.5</Flammability>
		</statBases>
		<stackLimit>10</stackLimit>
		<techLevel>Spacer</techLevel>
		<ingestible>
			<drugCategory>Medical</drugCategory>
			<baseIngestTicks>10</baseIngestTicks>
			<ingestSound>kotorsound_BF2ammoPickup</ingestSound>
			<outcomeDoers>
				<li Class="IngestionOutcomeDoer_GiveHediff">
					<hediffDef>SWCPHediff_BactaHeal</hediffDef>
					<severity>1.0</severity>
				</li>
			</outcomeDoers>
		</ingestible>
		<tradeTags>
			<li>guy762TT_GCWBacta</li>
		</tradeTags>
		<comps>
			<li Class="InstantHealingDrug.CompProperties_DrugInstantHeal">
				<listOrder>1761</listOrder>
				<isCombatEnhancingDrug>true</isCombatEnhancingDrug>
			</li>
		</comps>
		<orderedTakeGroup>Medicine</orderedTakeGroup>
	</ThingDef>
  
  
  
</Defs>