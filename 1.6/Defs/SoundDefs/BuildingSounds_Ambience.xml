<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	
	
	<SoundDef>
		<defName>kotorsound_building_telemetry_Purr</defName>
		<sustain>True</sustain>
		<context>MapOnly</context>
		<priorityMode>PrioritizeNearest</priorityMode>
		<maxSimultaneous>1</maxSimultaneous>
		<!-- <maxVoices>1</maxVoices> -->
		<subSounds>
		  <li>
			<muteWhenPaused>True</muteWhenPaused>
			<grains>
			  <li Class="AudioGrain_Clip">
				<clipPath>kotor_ambient_building/emt_telemetry_temple_lp02</clipPath>
			  </li>
			</grains>
			<volumeRange><min>10</min><max>10</max></volumeRange>
			<!-- very quiet sound range -->
			<distRange>10~40</distRange> <!-- enabled per user request -->
		  </li>
		</subSounds>
	</SoundDef>
	
	
	
