		<context>MapOnly</context>
		<eventNames />	
		<maxSimultaneous>1</maxSimultaneous>	
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>kotorshipweapons/wpn_cmbtSpdr_blaster_fire</clipPath>
