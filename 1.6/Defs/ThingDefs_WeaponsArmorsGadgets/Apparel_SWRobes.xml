<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	

	<ThingDef ParentName="guy762_ModdableMakeableArmor_soft">
		<defName>guy762_Robes_jawa</defName>
		<label>robes, rustic</label>
		<description>Thick robes like these are worn to protect the wearer from temperature extremes.\n\nUPGRADE SLOTS:\n- Armor Underlay (robe)</description>
		<graphicData>
		  <texPath>SWApparel/Robes/jawa/Apparel</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<Mass>8</Mass>
			<MarketValue>50</MarketValue>
			<MaxHitPoints>225</MaxHitPoints>
			<ArmorRating_Sharp>0.1</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.15</ArmorRating_Blunt>
			<ArmorRating_Heat>0.2</ArmorRating_Heat>
			
			<Insulation_Cold>25</Insulation_Cold>
			<Insulation_Heat>25</Insulation_Heat>
			
			<EquipDelay>9</EquipDelay>
			
			<WorkToMake>12500</WorkToMake>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>-0.1</MoveSpeed>
			<MeleeDodgeChance>-0.1</MeleeDodgeChance>
			<VEF_RangedDodgeChance MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">-0.1</VEF_RangedDodgeChance>
		</equippedStatOffsets>
		
		<costList>
			<Cloth>160</Cloth>
		</costList>
		<recipeMaker>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
			<recipeUsers Inherit="False">
				<li>HandTailoringBench</li>
				<li>ElectricTailoringBench</li>
				<li MayRequire="guy762.KotORWeapons">guy762_KotORWorkbench</li>
			</recipeUsers>
		</recipeMaker>
		
		
		<apparel>
			<layers>
				<li>Middle</li>
				<li>OnSkin</li>
			</layers>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<!-- <li>Neck</li> -->
				<li>Arms</li>
				<li>Hands</li>
				<li>Legs</li>
				<li>Feet</li>
			</bodyPartGroups>
			<tags Inherit="False">
				<li>SaV_apparel_jawa</li>
				<li>KotORClothing_civilian_villager</li>
				<li>SWCPSpecificApparelItem_KotORJawaRobes</li>
			</tags>
			<wornGraphicPath>SWApparel/Robes/jawa/Apparel</wornGraphicPath>
		</apparel>
		<tradeTags>
			<li>guy762TT_KotORClothes</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>10</weight>
					<only>(255,165,110)</only>  <!--jawa's nougat 100,65,45 hood -->
				</li>
				<li>
					<weight>10</weight>
					<only>(190,155,120)</only> <!-- beige -->
				</li>
				<li>
					<weight>10</weight>
					<only>(130,125,105)</only> <!-- khaki -->
				</li>
				<li>
					<weight>10</weight>
					<only>(125,100,75)</only> <!--K2 padawan-->
				</li>
				<li>
					<weight>10</weight>
					<only>(130,125,140)</only> <!-- bley -->
				</li>
			</options>
		</colorGenerator>
		<comps>
			<li MayRequire="kaitorisenkou.ModularWeapons2" Class="ModularWeapons2.CompProperties_ModularWeapon">
				<baseGraphicData>
					<texPath>SWApparel/Robes/jawa/Apparel</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</baseGraphicData>
				<partsMounts>
				  <li>
					<mountDef>guy762_KotORMount_underlay_robe</mountDef>
					<offset>(0,0)</offset>
					<layerOrder>1</layerOrder>
				  </li>
				</partsMounts>
			</li>
		</comps>
	</ThingDef>
	  
	  
	  
