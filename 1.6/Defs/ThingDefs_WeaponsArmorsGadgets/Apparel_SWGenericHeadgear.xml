			</skillRequirements>
		</recipeMaker>
		<costList>
			<Cloth>30</Cloth>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		
		<apparel>
			<wornGraphicPath>SWApparel/RebelEngineer/hat</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<bodyPartGroups>
				<li>UpperHead</li>
				<li>Neck</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
			<canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
			<renderNodeProperties>
				<li MayRequire="RedMattis.BetterPrerequisites" Class="BigAndSmall.PawnRenderingProps_Ultimate">
					<nodeClass>BigAndSmall.PawnRenderNode_UltimateApparel</nodeClass>
					<workerClass>BigAndSmall.URenderWorker_Apparel</workerClass>
					<parentTagDef>ApparelHead</parentTagDef>
					<shader>BS_CutoutThreeColor</shader>
					<baseLayer>71</baseLayer>	<!-- OVERHEAD -->
					<conditionalGraphics>
					  <texturePaths><li>SWApparel/RebelEngineer/hat</li></texturePaths>
					  <colorA>
						<apparelColorA>true</apparelColorA> <!-- uses colorGenerator color, do not use colorOptions on colorOne -->
						<alts><li><triggers><li>CustomColorAIsSet</li></triggers><customColorA>(1,1,1)</customColorA> </li></alts>
					  </colorA>
					  <colorB>
						<color>170,170,190</color> <!-- sith grey -->
						<alts><li><triggers><li>CustomColorBIsSet</li></triggers><customColorB>(1,1,1)</customColorB> </li></alts>
					  </colorB>
					</conditionalGraphics>
					<drawData> <dataNorth> <layer>71</layer> </dataNorth> </drawData>	<!-- OVERHEAD -->
				</li>
			</renderNodeProperties>
			
			<tags>
				<li>NewRepublic_engineer</li>
				<li>NewRepublic_RebelAgent_hats</li>
				<li>SWCPSpecificApparelItem_RebelEngineerHat</li>
			</tags>
			<defaultOutfitTags>
				<li>SWCPOutfitTag_Worker</li><li>Worker</li>
				<li>SWCPOutfitTag_Engineer</li>
			</defaultOutfitTags>
		</apparel>
		<tradeTags>
			<li>guy762TT_KotORClothes</li>
			<li>guy762TT_GCWApparel</li>
			<li>guy762TT_GCWArmor_PDFSurplus</li>
			<li>guy762TT_GCWArmor_RebelSurplus</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>15</weight>
					<only>(175,150,120)</only>       <!-- bespin beige -->
				</li>
			</options>
		</colorGenerator>
		<modExtensions>
		  <li MayRequire="RedMattis.BetterPrerequisites" Class="BigAndSmall.HasCustomizableGraphics">
			<!-- Tag is not needed for apparel. -->
			<colorA>true</colorA>
			<colorB>true</colorB>
			<!-- <colorC>true</colorC> -->
		  </li>
		</modExtensions>
	</ThingDef>
	
	
	
	
	
