<Defs>
	
	
	  
	<ThingDef ParentName="guy762_clothingbase">
		<defName>guy762_GenericUniform_fatigues</defName>
		<label>uniform, fatigues</label>
		<description>These are simple garments that protect little more than the modesty of the wearer.</description>
		<graphicData>
		  <texPath>SWApparel/GenericMilitaryFatigues/Apparel</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		  <shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<Mass>3</Mass>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<ArmorRating_Sharp>0.01</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.01</ArmorRating_Blunt>
			<ArmorRating_Heat>0.01</ArmorRating_Heat>
			<Insulation_Cold>10</Insulation_Cold>
			<Insulation_Heat>5</Insulation_Heat>
			<EquipDelay>3</EquipDelay>
			
			<WorkToMake>4000</WorkToMake>
		</statBases>
		
		<recipeMaker>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costList>
		  <Cloth>75</Cloth>
		</costList>
		
		<apparel>
		  <tags Inherit="False">
			<li>RemnantEmpire_armytrooper</li>
			<li>NewRepublic_RebelTrooperOnSkin</li>
			<li>SWCPSpecificApparelItem_GenericUniform</li>
		  </tags>
		  <wornGraphicPath>SWApparel/GenericMilitaryFatigues/Apparel</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
		  <defaultOutfitTags Inherit="False">
			<li>Worker</li>
		  </defaultOutfitTags>
		</apparel>
		<tradeTags>
			<li>guy762TT_KotORClothes</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_Options" Inherit="False">
			<options>
				<li>
					<weight>15</weight>
					<only>(175,150,120)</only>       <!-- bespin beige -->
				</li>
				<li>
					<weight>15</weight>
					<only>(65,65,60)</only> <!-- imperial army grey -->
				</li>
			</options>
		</colorGenerator>
	  </ThingDef>
	  
	  
	  
	  
	  
	  
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
