<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<!-- KotOR Backpacks -->
	
	
	<ThingDef ParentName="guy762_backpackMakeable">
		<defName>guy762_Backpack_light</defName>
		<label>backpack, light</label>
		<description>A simple backpack for carrying excess equipment.</description>
		<graphicData>
		  <texPath>SWApparel/Accessories/backpacks/backpack_small</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		  <shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
		  <Mass>3</Mass>
		  <MarketValue>100</MarketValue>
		  <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
		  <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
		  <ArmorRating_Heat>0.1</ArmorRating_Heat>
		  
		  <WorkToMake>4500</WorkToMake>
		</statBases>
		<equippedStatOffsets Inherit="False">
		  <VEF_MassCarryCapacity MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">50</VEF_MassCarryCapacity>
		</equippedStatOffsets>
		
		<recipeMaker>
		  <useIngredientsForColor>false</useIngredientsForColor>
		  <skillRequirements>
			<Crafting>4</Crafting>
		  </skillRequirements>
		</recipeMaker>
		<costList>
			<Plasteel>40</Plasteel>
		</costList>
		
		<tickerType>Never</tickerType>
		<apparel>
			<wornGraphicPath>SWApparel/Accessories/backpacks/backpack_small</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			
			 <tags>
				<li>KotORAccessory_any</li>
				<li>KotORAccessory_trooper</li>
				<li>KotORAccessory_civilian</li>
				<li>KotORAccessory_backpack</li>
				<li>KotORAccessory_smallbackpack</li>
				<li>SWCPSpecificApparelItem_KotORSmallBackpack</li>
				<li>SWCPDroidApparelRestrictionTag_Backpacks</li>
			</tags>
		</apparel>
		<tradeTags>
			<li>guy762TT_KotOREquipment_apparel</li>
			<li>guy762TT_GCWGadgetEquipment_ExoticLegal</li>
		</tradeTags>
		
		<colorGenerator Class="ColorGenerator_Options">
		  <options>
			<li>
				<weight>15</weight>
				<only>(135,145,150)</only>    <!-- dark teal-grey -->
			</li>
			<li>
				<weight>15</weight>
				<only>(165,175,165)</only>    <!-- faint olive grey -->
			</li>
			<li>
				<weight>15</weight>
				<only>(175,160,90)</only>    <!-- K1 "bag" container mustard -->
			</li>
			<li>
				<weight>15</weight>
				<only>(105,105,105)</only>    <!-- steel -->
			</li>
		  </options>
		</colorGenerator>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		
	</ThingDef>
	  
	<ThingDef ParentName="guy762_backpackbase">
		<defName>guy762_Backpack_scorch</defName>
		<label>backpack, commando's</label>
		<description>A simple backpack for carrying excess equipment.</description>
		<graphicData>
		  <texPath>SWApparel/Accessories/backpacks/backpack_scorch</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		  <!-- <shaderType>CutoutComplex</shaderType> -->
		  <!-- <colorTwo>(230,185,45)</colorTwo> -->
		</graphicData>
		<statBases>
		  <Mass>4</Mass>
		  <MarketValue>200</MarketValue>
		  <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
		  <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
		  <ArmorRating_Heat>0.1</ArmorRating_Heat>
		</statBases>
		<equippedStatOffsets Inherit="False">
		  <VEF_MassCarryCapacity MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">50</VEF_MassCarryCapacity>
		  <RangedCooldownFactor>-0.2</RangedCooldownFactor>
		</equippedStatOffsets>
		
		<tickerType>Never</tickerType>
		<apparel>
		  <tags>
			<li>KotORAccessory_scorchbackpack</li>
			<li>SWCPSpecificApparelItem_KotORScorchBackpack</li>
			<li>SWCPDroidApparelRestrictionTag_Backpacks</li>
		  </tags>
		  <wornGraphicPath>SWApparel/Accessories/backpacks/backpack_scorch</wornGraphicPath>
		  <useWornGraphicMask>true</useWornGraphicMask>
		  <drawData>
			  <dataEast>
				<layer>68</layer>
			  </dataEast>
			  <dataWest>
				<layer>68</layer>
			  </dataWest>
			  <dataSouth>
				  <layer>-3</layer>
			  </dataSouth>
			  <dataNorth>
				  <layer>68</layer>
			  </dataNorth>
			</drawData>
			
			<renderNodeProperties>
				<li MayRequire="RedMattis.BetterPrerequisites" Class="BigAndSmall.PawnRenderingProps_Ultimate">
					<nodeClass>BigAndSmall.PawnRenderNode_UltimateApparel</nodeClass>
					<workerClass>BigAndSmall.URenderWorker_Apparel</workerClass>
					<parentTagDef>ApparelBody</parentTagDef>
					<shader>BS_CutoutThreeColor</shader>
					<baseLayer>24</baseLayer>	<!-- BACKPACK -->
					<conditionalGraphics>
					  <texturePaths><li>SWApparel/Accessories/backpacks/backpack_scorch</li></texturePaths>
					  <colorA>
						<apparelColorA>true</apparelColorA> <!-- uses colorGenerator color, do not use colorOptions on colorOne -->
						<alts><li><triggers><li>CustomColorAIsSet</li></triggers><customColorA>(1,1,1)</customColorA> </li></alts>
					  </colorA>
					  <colorB>
						<color>230,185,45</color> <!-- republic yellow -->
						<alts><li><triggers><li>CustomColorBIsSet</li></triggers><customColorB>(1,1,1)</customColorB> </li></alts>
					  </colorB>
					</conditionalGraphics>
					<drawData>
						<dataSouth> <layer>-1</layer> </dataSouth>
						<dataNorth> <layer>99</layer> </dataNorth>
					</drawData>
				</li>
			</renderNodeProperties>
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
		  <options>
			<li>
				<weight>15</weight>
				<only>(140,140,150)</only>  <!--silver-->
			</li>
		  </options>
		</colorGenerator>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		<modExtensions>
		  <li MayRequire="RedMattis.BetterPrerequisites" Class="BigAndSmall.HasCustomizableGraphics">
			<!-- Tag is not needed for apparel. -->
			<colorA>true</colorA>
			<colorB>true</colorB>
			<!-- <colorC>true</colorC> -->
		  </li>
		</modExtensions>
	</ThingDef>
	 
