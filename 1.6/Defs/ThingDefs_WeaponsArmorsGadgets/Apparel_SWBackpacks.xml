			<li>
				<weight>15</weight>
				<only>(115,120,75)</only> <!-- olive green -->
			</li>
			<li>
				<weight>15</weight>
				<only>(125,125,125)</only> <!-- mid grey -->
			</li>
			<li>
				<weight>15</weight>
				<only>(175,150,120)</only> <!-- bespin beige -->
			</li>
		  </options>
		</colorGenerator>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		<tradeTags>
			<li>guy762TT_RebelArmor</li>
		</tradeTags>
	</ThingDef>
	
	
	
	
	
	
	
