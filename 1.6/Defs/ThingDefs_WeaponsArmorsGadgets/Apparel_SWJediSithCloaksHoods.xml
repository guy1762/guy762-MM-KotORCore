<?xml version="1.0" encoding="utf-8" ?>
<Defs>

        <!--cloaks-->
  
  
  
  
  
  <ThingDef ParentName="guy762_armorbase_soft">
    <defName>guy762_JediCloak_light</defName>
    <label>cloak, simple</label>
    <description>This is a simple robe worn by ordinary civilians and Jedi alike.</description>
    <graphicData>
      <texPath>SWApparel/Jedi/cloak_1/Apparel</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
		<Mass>5</Mass>
		<MarketValue>50</MarketValue>
		<MaxHitPoints>100</MaxHitPoints>
		<ArmorRating_Sharp>0.01</ArmorRating_Sharp>
		<ArmorRating_Blunt>0.01</ArmorRating_Blunt>
		<ArmorRating_Heat>0.01</ArmorRating_Heat>
		
		<Insulation_Cold>15</Insulation_Cold>
        <Insulation_Heat>15</Insulation_Heat>
		
		<EquipDelay>3</EquipDelay>
		<WorkToMake>9500</WorkToMake>
	</statBases>
	<!--equippedStatOffsets>
	  <PsychicSensitivity>0.1</PsychicSensitivity>
      <PsychicEntropyRecoveryRate>0.1</PsychicEntropyRecoveryRate>
    </equippedStatOffsets-->
	
	<!-- //////////////////////////////////////////////////////////////////////////////// NOTE: the function that cancels the "soaking wet" and "tox rain" thoughts when this item is worn is done through a PATCH!!!  -->
	
    <apparel>
		<drawData>
			<dataNorth>
			  <layer>79</layer>
			</dataNorth>
		</drawData>
		<layers>
			<li>Shell</li>
		</layers>
		<bodyPartGroups>
			<li>Torso</li>
			<li>Neck</li>
			<li>Shoulders</li>
			<li>Arms</li>
			<li>Legs</li>
		</bodyPartGroups>
		<tags Inherit="False">
			<li>KotORClothing_civilian_prole</li>
			<li>KotORClothing_civilian_hooded</li>
			<li>KotORClothing_simplecloak</li>
			<li>SWCPAccessory_CloakOrPlainPoncho</li>
			<li>OR_jedi</li>
			<li>OR_jedicloak_light</li>
			<li>SWCPSpecificApparelItem_SimpleCloak</li>
		</tags>
		<wornGraphicPath>SWApparel/Jedi/cloak_1/Apparel</wornGraphicPath>
		
		<canBeGeneratedToSatisfyWarmth>true</canBeGeneratedToSatisfyWarmth>
    </apparel>
	<tradeTags>
		<li>guy762TT_KotORClothes</li>
		<li>guy762TT_JediApparel</li>
	</tradeTags>
	<costList>
		<Cloth>80</Cloth>
	</costList>
	<recipeMaker>
		<skillRequirements>
			<Crafting>4</Crafting>
		</skillRequirements>
		<recipeUsers Inherit="False">
			<li>HandTailoringBench</li>
			<li>ElectricTailoringBench</li>
			<li MayRequire="guy762.KotORWeapons">guy762_KotORWorkbench</li>
		</recipeUsers>
	</recipeMaker>
	<colorGenerator Class="ColorGenerator_Options" Inherit="False">
		<options>
			<li>
				<weight>95</weight>
				<only>(125,100,75)</only>       <!--K2 padawan-->
			</li>
			<li>
				<weight>100</weight>
				<only>(90,55,40)</only>         <!--K2 jedi knight-->
			</li>
		</options>
	</colorGenerator>
  </ThingDef>
  
