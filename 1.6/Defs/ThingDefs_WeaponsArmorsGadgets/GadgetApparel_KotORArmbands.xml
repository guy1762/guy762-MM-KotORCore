		  <texPath>Items/armband_moncal</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
		  <Mass>4</Mass>
		  <MarketValue>3337</MarketValue>
		  <MaxHitPoints>110</MaxHitPoints>
		  <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
		  <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
		  <ArmorRating_Heat>0.35</ArmorRating_Heat>
		  <EquipDelay>3</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<AimingDelayFactor>0.1</AimingDelayFactor>
			<MeleeDodgeChance>-0.1</MeleeDodgeChance>
			<VEF_RangedDodgeChance MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">-0.1</VEF_RangedDodgeChance>
			<IncomingDamageFactor>-0.05</IncomingDamageFactor>
		</equippedStatOffsets>
		<techLevel>Spacer</techLevel>
		
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<careIfDamaged>false</careIfDamaged>
			<ignoredByNonViolent>true</ignoredByNonViolent>
			<wearPerDay>0</wearPerDay>
			<bodyPartGroups>
				<li>Arms</li>
			</bodyPartGroups>
			<layers>
				<li>Belt</li>
			</layers>
			
			<tags>
				<li>KotOREquipment_moncal</li>
				<li>SWCPSpecificGadgetItem_MonCalamariArmband</li>
			</tags>
		</apparel>
		<tradeTags>
			<li>guy762TT_KotORAntique</li>
			<li>guy762TT_GCWGadgetEquipment_ExoticLegal</li>
		</tradeTags>
	</ThingDef>
  
  
  
  
  
  
  
  
  
  
  <ThingDef ParentName="guy762_UtilityItemBase">
    <defName>guy762_armband_cortosis</defName>
    <label>cortosis gauntlet</label>
    <description>These heavy armored gauntlets are capable of temporarily disabling a Lightsaber upon contact with one, provided the wearer is dexterous enough to block an incoming blow with it.</description>
    <graphicData>
      <texPath>Items/armband_cortosis</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
	<statBases>
      <Mass>5</Mass>
	  <MarketValue>10440</MarketValue>
	  <MaxHitPoints>175</MaxHitPoints>
	  <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
	  <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
	  <ArmorRating_Heat>999</ArmorRating_Heat> <!-- maxed out for maximum block chance -->
      <EquipDelay>3</EquipDelay>
    </statBases>
    <techLevel>Spacer</techLevel>
	
    <apparel>
		<countsAsClothingForNudity>false</countsAsClothingForNudity>
		<careIfWornByCorpse>false</careIfWornByCorpse>
		<careIfDamaged>false</careIfDamaged>
		<ignoredByNonViolent>true</ignoredByNonViolent>
		<wearPerDay>0</wearPerDay>
		<bodyPartGroups>
			<li>Arms</li>
			<!-- <li>Hands</li> -->
		</bodyPartGroups>
		<layers>
			<li>Belt</li>
		</layers>  
		<useDeflectMetalEffect>true</useDeflectMetalEffect>
		
		<tags>
			<li>SWCPSpecificGadgetItem_CortosisArmband</li>
		</tags>
    </apparel>
	<tradeTags>
		<li>guy762TT_KotORElite</li>
		<li>guy762TT_GCWGadgetEquipment_ExoticIllegal</li>
		<li>guy762TT_GCWGadgetEquipment_JediStuff</li>
    </tradeTags>
	
	<modExtensions>
		<li Class="Lightsaber.ModExtension_Conductive" MayRequire="lee.theforce.lightsaber">
			<shortCircuitChance>1</shortCircuitChance>
		</li>
	</modExtensions>
  </ThingDef>
  
  
  
  
  
  
  
  
  
</Defs>
