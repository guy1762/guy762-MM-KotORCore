<?xml version="1.0" encoding="utf-8" ?>
<Defs>


	<HediffDef ParentName="AddedBodyPartBase">
		<defName>SWCPHediff_BionicHand</defName>
		<label>bionic hand</label>
		<labelNoun>a bionic hand</labelNoun>
		<description>An installed bionic hand.</description>
		<comps>
			<li Class="HediffCompProperties_VerbGiver">
				<tools>
					<li>
						<label>fist</label>
						<capacities>
						  <li>Blunt</li>
						</capacities>
						<power>12</power>
						<cooldownTime>2</cooldownTime>
						<soundMeleeHit>MeleeHit_BionicPunch</soundMeleeHit>
						<soundMeleeMiss>MeleeMiss_BionicPunch</soundMeleeMiss>
					</li>
				</tools>
			</li>
		</comps>
		<addedPartProps>
			<solid>true</solid>
			<partEfficiency>1.25</partEfficiency>
			<betterThanNatural>true</betterThanNatural>
		</addedPartProps>
		<spawnThingOnRemoved>SWCPItem_BionicHand</spawnThingOnRemoved>
	</HediffDef>

	<RecipeDef ParentName="SurgeryInstallBodyPartArtificialBase">
		<defName>SWCPRecipe_InstallBionicHand</defName>
		<label>install bionic hand</label>
		<description>Install a bionic hand.</description>
		<descriptionHyperlinks><ThingDef>SWCPItem_BionicHand</ThingDef><HediffDef>SWCPHediff_BionicHand</HediffDef></descriptionHyperlinks>
		<jobString>Installing bionic hand.</jobString>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>SWCPItem_BionicHand</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>SWCPItem_BionicHand</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>Hand</li>
		</appliedOnFixedBodyParts>
		<addsHediff>SWCPHediff_BionicHand</addsHediff>
	</RecipeDef>
	
	
	<ThingDef ParentName="BodyPartBionicBase">
		<defName>SWCPItem_BionicHand</defName>
		<label>bionic hand</label>
		<description>An advanced artificial hand. Silenced mini-servos give great strength, while the biogel nerve-link gives exquisite control. A lattice-dust healing system allows it to recover from damage. It is better than a biological hand in almost every way.</description>
		<descriptionHyperlinks><RecipeDef>SWCPRecipe_InstallBionicHand</RecipeDef></descriptionHyperlinks>
		<costList>
		  <Plasteel>6</Plasteel>
		  <ComponentSpacer>2</ComponentSpacer>
		</costList>
		<thingSetMakerTags><li>RewardStandardMidFreq</li></thingSetMakerTags>
		<statBases>
			<Mass>2</Mass>
		</statBases>
	</ThingDef>

</Defs>
