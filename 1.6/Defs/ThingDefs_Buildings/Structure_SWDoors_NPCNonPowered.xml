<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  
	
	<ThingDef ParentName="BuildingBase" Name="guy762_NPCAutoDoorBase" Abstract="True">
		<thingClass>Building_Door</thingClass>
		<category>Building</category>
		<altitudeLayer>DoorMoveable</altitudeLayer>
		<fillPercent>1</fillPercent>
		<useHitPoints>true</useHitPoints>
		
		<graphicData>
			<!--  no damage marks because they don't move with the door  -->
			<damageData><enabled>false</enabled></damageData>
		</graphicData>
		
		<!-- <stuffCategories> -->
		  <!-- <li>Metallic</li> -->
		  <!-- <li>Woody</li> -->
		  <!-- <li>Stony</li> -->
		<!-- </stuffCategories> -->
		<statBases>
		  <!-- <WorkToBuild>1100</WorkToBuild> -->
		  <Flammability>0</Flammability>
		</statBases>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<selectable>true</selectable>
		<tickerType>Normal</tickerType>
		<rotatable>false</rotatable>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<blockWind>true</blockWind>
		<uiOrder>2010</uiOrder>
		<holdsRoof>true</holdsRoof>
		<staticSunShadowHeight>1.0</staticSunShadowHeight>
		<blockLight>true</blockLight>
		<drawerType>RealtimeOnly</drawerType>
		<forceMoveItemsBeforeConstruction>true</forceMoveItemsBeforeConstruction>
		<building>
			<isInert>true</isInert>
			<canPlaceOverWall>true</canPlaceOverWall>
			<!-- <soundDoorOpenPowered>Door_OpenPowered</soundDoorOpenPowered> -->
			<!-- <soundDoorClosePowered>Door_ClosePowered</soundDoorClosePowered> -->
			<soundDoorOpenManual>Door_OpenManual</soundDoorOpenManual>
			<soundDoorCloseManual>Door_CloseManual</soundDoorCloseManual>
			<blueprintClass>Blueprint_Door</blueprintClass>
			<blueprintGraphicData>
				<texPath>Things/Building/Door/Door_Blueprint</texPath>
			</blueprintGraphicData>
			<ai_chillDestination>false</ai_chillDestination>
			<paintable>true</paintable>
			<canExchangeVacuum>true</canExchangeVacuum>
			
			<neverBuildable>true</neverBuildable>
		</building>
		<comps>
			<li Class="CompProperties_Forbiddable">
				<allowNonPlayer>true</allowNonPlayer>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTransmitter</compClass>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<replaceTags>
		  <li>Door</li>
		</replaceTags>
		<placeWorkers>
		  <li>PlaceWorker_DoorLearnOpeningSpeed</li>
		</placeWorkers>
		
		<designationHotKey>Misc2</designationHotKey>
		<!-- <researchPrerequisites> -->
		  <!-- <li>Autodoors</li> -->
		<!-- </researchPrerequisites> -->
		<!-- <constructionSkillPrerequisite>6</constructionSkillPrerequisite> -->
		
		<designationCategory>KOTOR_BuildTab</designationCategory>
		<designatorDropdown>guy762_DoorDropdown_SWAutoDoors</designatorDropdown>
	</ThingDef>
	














	
	<ThingDef ParentName="guy762_NPCAutoDoorBase">
		<defName>guy762_NPCAutodoor1x1_DoomgiverA</defName>
		<label>plain autodoor</label>
		<description>Divides rooms. Powered operation allows people to move through the door without slowing down.</description>
		<graphicData>
			<texPath>Buildings/Doors/Doomgiver1x1DoorA</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<!-- <shaderType>CutoutComplex</shaderType> -->
			<color>(155,155,165)</color>
		</graphicData>
		<uiIconPath>Buildings/Doors/Doomgiver1x1DoorA_icon</uiIconPath>
		
		
		<thingClass>SWCP.RimframeGrineerDoors.Building_CustomMultiTileDoor_DoubleOpeningHeight</thingClass>
		<modExtensions>
			<li Class="SWCP.RimframeGrineerDoors.DoorPartGraphicsExtension">
				<leftPartGraphicData>
					<texPath>Buildings/Doors/Doomgiver1x1DoorA</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<!-- <shaderType>CutoutComplex</shaderType> -->
					<drawSize>(1, 1)</drawSize>
				</leftPartGraphicData>
			</li>
		</modExtensions>
		
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<DoorOpenSpeed>0.5</DoorOpenSpeed>
		</statBases>
		<building>
			<isAirtight>true</isAirtight>
			<!-- <soundDoorOpenPowered>kotorsound_building_ImperialDoor</soundDoorOpenPowered> -->
			<!-- <soundDoorClosePowered>kotorsound_building_DoorClose</soundDoorClosePowered> -->
			<soundDoorOpenManual>kotorsound_building_ImperialDoor</soundDoorOpenManual>
			<soundDoorCloseManual>kotorsound_building_DoorClose</soundDoorCloseManual>
			
			<paintable>false</paintable>
			<doorTopGraphic>
				<texPath>Buildings/Doors/SingleDoorFrame_Square</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<shaderType>CutoutComplex</shaderType>
				<drawSize>1.25</drawSize>
			</doorTopGraphic>
		</building>
	</ThingDef>
	
	
	
	
	
	
