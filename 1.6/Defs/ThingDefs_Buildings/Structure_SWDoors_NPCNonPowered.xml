				<texPath>Buildings/Doors/NPCSingleDoorFrame_Square</texPath>
				<graphicClass>Graphic_Multi</graphicClass>
				<shaderType>CutoutComplex</shaderType>
				<drawSize>1.25</drawSize>
			</doorTopGraphic>
		</building>
	</ThingDef>
	
	
	
	

	
</Defs>
