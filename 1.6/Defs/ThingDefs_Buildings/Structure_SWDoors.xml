	<!-- ================= Autodoors ================= -->
	
	<DesignatorDropdownGroupDef>
		<defName>guy762_DoorDropdown_SWAutoDoors</defName>
		<label>autodoors</label>
	</DesignatorDropdownGroupDef>
	
	<ThingDef ParentName="BuildingBase" Name="guy762_AutoDoorBase" Abstract="True">
		<thingClass>Building_Door</thingClass>
		<category>Building</category>
		<altitudeLayer>DoorMoveable</altitudeLayer>
		<fillPercent>1</fillPercent>
		<useHitPoints>true</useHitPoints>
		
		<graphicData>
			<!--  no damage marks because they don't move with the door  -->
			<damageData><enabled>false</enabled></damageData>
		</graphicData>
		
		<!-- <stuffCategories> -->
		  <!-- <li>Metallic</li> -->
		  <!-- <li>Woody</li> -->
		  <!-- <li>Stony</li> -->
		<!-- </stuffCategories> -->
		<statBases>
		  <WorkToBuild>1100</WorkToBuild>
		  <Flammability>0</Flammability>
		</statBases>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
		<selectable>true</selectable>
		<tickerType>Normal</tickerType>
		<rotatable>false</rotatable>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<blockWind>true</blockWind>
		<uiOrder>2010</uiOrder>
		<holdsRoof>true</holdsRoof>
		<staticSunShadowHeight>1.0</staticSunShadowHeight>
		<blockLight>true</blockLight>
		<drawerType>RealtimeOnly</drawerType>
		<forceMoveItemsBeforeConstruction>true</forceMoveItemsBeforeConstruction>
		<building>
			<isInert>true</isInert>
			<canPlaceOverWall>true</canPlaceOverWall>
			<!-- <soundDoorOpenPowered>Door_OpenPowered</soundDoorOpenPowered> -->
			<!-- <soundDoorClosePowered>Door_ClosePowered</soundDoorClosePowered> -->
			<soundDoorOpenManual>Door_OpenManual</soundDoorOpenManual>
			<soundDoorCloseManual>Door_CloseManual</soundDoorCloseManual>
			<blueprintClass>Blueprint_Door</blueprintClass>
			<blueprintGraphicData>
				<texPath>Things/Building/Door/Door_Blueprint</texPath>
			</blueprintGraphicData>
			<ai_chillDestination>false</ai_chillDestination>
			<paintable>true</paintable>
			<canExchangeVacuum>true</canExchangeVacuum>
		</building>
		<comps>
			<li Class="CompProperties_Forbiddable">
				<allowNonPlayer>true</allowNonPlayer>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>50</basePowerConsumption>
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<replaceTags>
		  <li>Door</li>
		</replaceTags>
		<placeWorkers>
		  <li>PlaceWorker_DoorLearnOpeningSpeed</li>
		</placeWorkers>
		
		<designationHotKey>Misc2</designationHotKey>
		<researchPrerequisites>
		  <li>Autodoors</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		
		<designationCategory>KOTOR_BuildTab</designationCategory>
		<designatorDropdown>guy762_DoorDropdown_SWAutoDoors</designatorDropdown>
	</ThingDef>
	
	
	
	
	
	
	
	
	
	
