	<StatDef>
		<defName>SWCPStat_Stealth</defName>
		<label>sneaking stealth</label>
		<description>This stat reduces the chance of nearby enemies being able to cast Awareness Checks while this pawn is in stealth mode.\nThis stat is determined by the pawn's Animals skill and Moving capacity level.</description>
		<!-- <description>This stat reduces the chance of hunted animals attacking the hunter.\n\nA 0% score means no reduction.\nA 100% score means animals never attack.</description> -->
		<category>SWCPStatCategory</category>
		<displayPriorityInCategory>1</displayPriorityInCategory>
		
		<showOnPawns>true</showOnPawns>
		<!-- <neverDisabled>true</neverDisabled> -->
		<!-- <alwaysHide>false</alwaysHide> -->
		<!-- <showIfUndefined>false</showIfUndefined> -->
		<!-- <hideAtValue>0</hideAtValue> -->
		
		<defaultBaseValue>1</defaultBaseValue>
		<minValue>0</minValue>
		<toStringStyle>PercentZero</toStringStyle>
		<skillNeedOffsets>
			<li Class="SkillNeed_BaseBonus">
				<skill>Animals</skill>
				<baseValue>0</baseValue>
				<bonusPerLevel>0.05</bonusPerLevel>
			</li>
		</skillNeedOffsets>
		<capacityFactors>
			<li>
				<capacity>Moving</capacity>
				<weight>1</weight>
			</li>
		</capacityFactors>
		
		<parts>
			<li Class="StatPart_GearStatOffset">
				<apparelStat>SWCPStat_StealthGearOffset</apparelStat>
				<includeWeapon>true</includeWeapon>
			</li>
			<!-- <li Class="StatPart_Age"> -->
				<!-- <curve> -->
				  <!-- <points> -->
					<!-- <li>(0.65,1)</li> -->
					<!-- <li>(0.8,0.95)</li> -->
					<!-- <li>(1.0,0.9)</li> -->
					<!-- <li>(1.2,0.8)</li> -->
					<!-- <li>(1.5,0.5)</li> -->
				  <!-- </points> -->
				<!-- </curve> -->
			<!-- </li> -->
		</parts>
	</StatDef>
	
	
	<StatDef>
		<defName>SWCPStat_StealthGearOffset</defName>
		<label>sneaking stealth gear offset</label>
		<description>This stat multiplies the base sneaking stealth stat through an equipped item bonus.</description>
		<!-- <description>This stat reduces the chance of hunted animals attacking the hunter.\n\nA 0% score means no reduction.\nA 100% score means animals never attack.</description> -->
		<category>SWCPStatCategory</category>
		<displayPriorityInCategory>2</displayPriorityInCategory>
		
		<showOnAnimals>false</showOnAnimals>
		<showIfUndefined>false</showIfUndefined>
		<showOnPawns>false</showOnPawns>
		<alwaysHide>true</alwaysHide>
		<hideAtValue>0</hideAtValue>
		<defaultBaseValue>0</defaultBaseValue>
		<toStringStyle>PercentZero</toStringStyle>
		<parts>
			<li Class="StatPart_Quality">
				<factorAwful>0.8</factorAwful>
				<factorPoor>0.9</factorPoor>
				<factorNormal>1</factorNormal>
				<factorGood>1.1</factorGood>
				<factorExcellent>1.2</factorExcellent>
				<factorMasterwork>1.5</factorMasterwork>
				<factorLegendary>1.8</factorLegendary>
				<applyToNegativeValues>true</applyToNegativeValues>
			</li>
		</parts>
		<cacheable>true</cacheable>
	</StatDef>

		
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
