<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<ThingDef Name="guy762_BaseGrenadeProjectile" Abstract="True">
		<category>Projectile</category>
		<altitudeLayer>Projectile</altitudeLayer>
		<thingClass>Projectile_Explosive</thingClass>
		<label>projectile</label>
		<tickerType>Normal</tickerType>
		<useHitPoints>False</useHitPoints>
		<neverMultiSelect>True</neverMultiSelect>
		<graphicData>
		  <shaderType>Transparent</shaderType>
		</graphicData>
		<projectile>
		  <!-- <speed>12</speed> -->
		  <speed>15</speed>
		  <arcHeightFactor>2</arcHeightFactor>
		  <shadowSize>0.4</shadowSize>
		</projectile>
	</ThingDef>
	
	<ThingDef ParentName="guy762_BaseGrenadeProjectile">
		<defName>guy762_ThrownGrenade_frag</defName>
		<label>frag grenade</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
		  <texPath>Weapons/Projectiles/Grenades/grenade_frag</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <explosionRadius>2.2</explosionRadius >
		  <damageDef>guy762_GrenadeDamage_frag</damageDef>
		  <damageAmountBase>50</damageAmountBase>
		  <explosionDelay>100</explosionDelay>
		  <!--soundAmbient>kotorsound_grenadecook</soundAmbient-->
		</projectile>
	</ThingDef>
	
	<ThingDef ParentName="guy762_BaseGrenadeProjectile">
		<defName>guy762_ThrownGrenade_ion</defName>
		<label>ion grenade</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
		  <texPath>Weapons/Projectiles/Grenades/grenade_ion</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <explosionRadius>3.5</explosionRadius >
		  <damageDef>guy762_GrenadeDamage_ion</damageDef>
		  <damageAmountBase>50</damageAmountBase>
		  <explosionDelay>100</explosionDelay>
		  <!--soundAmbient>kotorsound_grenadecook</soundAmbient-->
		  <extraDamages>
				<li>
					<def>EMP</def>
					<amount>50</amount>
				</li>
			</extraDamages>
		</projectile>
	</ThingDef>
	
	<ThingDef ParentName="guy762_BaseGrenadeProjectile">
		<defName>guy762_ThrownGrenade_stun</defName>
		<label>stun grenade</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
		  <texPath>Weapons/Projectiles/Grenades/grenade_stun</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <explosionRadius>3.5</explosionRadius >
		  <!--damageDef>guy762_GrenadeDamage_stun</damageDef-->
		  <damageDef>Stun</damageDef>
		  <explosionDelay>100</explosionDelay>
		  <!--soundAmbient>kotorsound_grenadecook</soundAmbient-->
		  <soundExplode>kotorsound_stungrenade</soundExplode>
		</projectile>
	</ThingDef>
	
	<ThingDef MayRequire="Ludeon.RimWorld.Biotech" ParentName="guy762_BaseGrenadeProjectile">
		<defName>guy762_ThrownGrenade_poison</defName>
		<label>poison grenade</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
		  <texPath>Weapons/Projectiles/Grenades/grenade_poison</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <damageDef>ToxGas</damageDef>
		  <explosionDelay>100</explosionDelay>
		  <explosionRadius>1.9</explosionRadius>
		  <explosionRadiusDisplayPadding>2</explosionRadiusDisplayPadding>
		  <postExplosionGasType>ToxGas</postExplosionGasType>
		  <screenShakeFactor>0.5</screenShakeFactor>
		  <!--soundAmbient>kotorsound_grenadecook</soundAmbient-->
		  <soundExplode>kotorsound_poisongrenade</soundExplode>
		</projectile>
	</ThingDef>
	
	<ThingDef ParentName="guy762_BaseGrenadeProjectile">
		<defName>guy762_ThrownGrenade_plasma</defName>
		<label>plasma grenade</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
		  <texPath>Weapons/Projectiles/Grenades/grenade_plasma</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <explosionRadius>2.3</explosionRadius >
		  <damageDef>guy762_GrenadeDamage_plasma</damageDef>
		  <damageAmountBase>50</damageAmountBase>
		  <explosionDelay>100</explosionDelay>
		  <ai_IsIncendiary>true</ai_IsIncendiary>
		  <shadowSize>0.6</shadowSize>
		  <screenShakeFactor>0.5</screenShakeFactor>
		  <!--soundAmbient>kotorsound_grenadecook</soundAmbient-->
		  <extraDamages>
				<li>
					<def>guy762_GrenadeDamage_ion</def>
					<amount>25</amount>
				</li>
			</extraDamages>
		</projectile>
	</ThingDef>
	
	<ThingDef ParentName="guy762_BaseGrenadeProjectile">
		<defName>guy762_ThrownGrenade_sonic</defName>
		<label>sonic grenade</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
		  <texPath>Weapons/Projectiles/Grenades/grenade_sonic</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <explosionRadius>3</explosionRadius>
		  <damageDef>guy762_GrenadeDamage_sonic</damageDef>
		  <damageAmountBase>50</damageAmountBase>
		  <explosionDelay>100</explosionDelay>
		  <!--soundAmbient>kotorsound_grenadecook</soundAmbient-->
		</projectile>
	</ThingDef>
	
	<ThingDef ParentName="guy762_BaseGrenadeProjectile">
		<defName>guy762_ThrownGrenade_thermaldet</defName>
		<label>thermal detonator</label>
		<thingClass>Projectile_Explosive</thingClass>
		<graphicData>
		  <texPath>Weapons/Projectiles/Grenades/grenade_thermaldet</texPath>
		  <graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
		  <explosionRadius>1.9</explosionRadius >
		  <damageDef>guy762_GrenadeDamage_thermaldet</damageDef>
		  <damageAmountBase>75</damageAmountBase>
		  <explosionDelay>100</explosionDelay>
		  <screenShakeFactor>1</screenShakeFactor>
		  <!--soundAmbient>kotorsound_grenadecook</soundAmbient-->
		</projectile>
	</ThingDef>
  

</Defs>